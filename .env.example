# OANDA API credentials (cuenta DEMO)
# Crea una cuenta demo en https://www.oanda.com/demo-account/
OANDA_API_KEY=tu_api_key_aqui
OANDA_ACCOUNT_ID=tu_account_id_aqui
OANDA_ENVIRONMENT=practice  # 'practice' para demo, 'live' para cuenta real

# Instrumentos a operar (separados por coma)
INSTRUMENTS=XAU_USD,EUR_USD

# Granularidad de las velas de entrada y de confirmación HTF
GRANULARITY=M1
GRANULARITY_HTF=M5

# Gestión de riesgo
RISK_PER_TRADE=0.01         # 1% del balance por trade
MAX_CONCURRENT_TRADES=2     # Máximo de operaciones simultáneas
MAX_DAILY_LOSS=0.05         # Pausa el bot si pierde 5% en el día (NAV, incluye flotante)
ATR_SL_MULT=1.2             # Stop loss = ATR * 1.2
ATR_TP_MULT=2.0             # Take profit = ATR * 2.0 (R:R ~1:1.67)

# Estrategia
STRATEGY_MODE=trend_pullback  # trend_pullback | mean_reversion
MIN_ADX=20                    # Fuerza mínima de la tendencia
RSI_BUY_THRESHOLD=40          # COMPRA en pullback cuando RSI ≤ 40
RSI_SELL_THRESHOLD=60         # VENTA en pullback cuando RSI ≥ 60
EMA_FAST=20                   # EMA rápida para tendencia
EMA_SLOW=50                   # EMA lenta para tendencia
SPREAD_ATR_RATIO=0.15         # Salta el trade si spread > ATR * 0.15
HTF_CONFIRMATION=true         # Exigir que la tendencia M5 coincida con la entrada M1

# Breakeven + trailing
BREAKEVEN_ENABLED=true
BREAKEVEN_TRIGGER_R=1.0       # Mueve SL al entry al alcanzar 1R a favor
TRAILING_ENABLED=true
TRAILING_ATR_MULT=1.2         # Después del BE arrastra SL a close ± ATR*1.2

# Cooldown entre trades del mismo instrumento (segundos)
TRADE_COOLDOWN_SECONDS=300

# Sesiones de trading (UTC). Formato Nombre:H_inicio-H_fin separadas por coma
SESSIONS_UTC=Londres:7-12,Nueva York:13-17

# Frecuencia de análisis (segundos)
LOOP_INTERVAL=20

# Logging
LOG_LEVEL=INFO

# CSV de operaciones (se monta en el host vía ./logs)
TRADE_LOG_PATH=/app/logs/trades.csv

# Telegram (opcional). Si ambos están vacíos, se desactivan las notificaciones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
